# # Flask Configuration
# FLASK_APP=app.py
# FLASK_ENV=development
# SECRET_KEY=your-secret-key-here

# # Database Configuration
# DATABASE_URL=postgresql://jeff:password@localhost/jeff_db

# # Twilio WhatsApp Configuration
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# # OpenAI Configuration
# OPENAI_API_KEY=your_openai_api_key

# # Anthropic Claude Configuration (Primary LLM)
# ANTHROPIC_API_KEY=your_anthropic_api_key

# # Payment Configuration (PayNow/EcoCash Integration)
# TOKEN_PRICE=1.00

# PAYNOW_INTEGRATION_ID=your_integration_id_here
# PAYNOW_INTEGRATION_KEY=your_integration_key_here
# PAYNOW_RETURN_URL=http://localhost:8000/payment/success/
# PAYNOW_RESULT_URL=https://yourdomain.com/payment/webhook/

# # EcoCash Configuration (Legacy support)
# ECOCASH_INTEGRATION_ID=your_ecocash_integration_id
# ECOCASH_INTEGRATION_KEY=your_ecocash_integration_key
# ECOCASH_RETURN_URL=http://localhost:8000/payment/success/
# ECOCASH_RESULT_URL=https://yourdomain.com/payment/webhook/

# # App Settings
# MAX_PROPERTY_RESULTS=5
# ADMIN_PHONE=+263771234567
# DOMAIN_HOST=https://yourdomain.com

# # Twilio Content Template SIDs for WhatsApp
# TWILIO_CONTENT_TEMPLATE_SID_PROVIDER_BOOKING=your_template_sid_for_provider_booking
# TWILIO_CONTENT_TEMPLATE_SID_STUDENT_CONFIRMATION=your_template_sid_for_student_confirmation
# TWILIO_CONTENT_TEMPLATE_SID_STUDENT_REJECTION=your_template_sid_for_student_rejection
# TWILIO_CONTENT_TEMPLATE_SID_STUDENT_INFO_REQUEST=your_template_sid_for_student_info_request
# TWILIO_CONTENT_TEMPLATE_SID_PROVIDER_INFO_RESPONSE=your_template_sid_for_provider_info_response
# TWILIO content template SID used when a provider fails to respond within 8 hours.
# Variables mapping expected by the template:
# 1 -> Student name
# 2 -> Booking reference
# 3 -> Property name
# 4 -> Provider name
# 5 -> Student phone
# TWILIO_CONTENT_TEMPLATE_SID_RESTART_SEARCH=your_template_sid_for_restart_search

# # Frontend-Backend API Security Configuration
# DJANGO_API_KEY=your_generated_api_key_here
# DJANGO_API_URL=http://localhost:8000

# # Security Configuration
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
# CSP_ENABLED=True
# API_RATE_LIMIT_REQUESTS_PER_MINUTE=30
# API_REQUEST_TIMEOUT_MS=10000
# API_MAX_RETRIES=3

# # Frontend Configuration
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000